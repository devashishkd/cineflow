# ─── JWT ─────────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_change_in_production

# ─── Service URLs ─────────────────────────────────
USER_SERVICE_URL=http://localhost:3001
MOVIE_SERVICE_URL=http://localhost:3002
BOOKING_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004

# ─── Database URLs ────────────────────────────────
# Local Docker:
# DB_URL=postgresql://postgres:postgres@localhost:5432/user_db
# Neon (production):
DB_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require

# ─── Redis ────────────────────────────────────────
# Local Docker:
# REDIS_URL=redis://localhost:6379
# Upstash (production):
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# ─── Kafka (Aiven) ────────────────────────────────
# Local Docker:
# KAFKA_BROKER=localhost:9092
# Aiven (production):
KAFKA_BROKER=kafka-364cb349-cineflow.k.aivencloud.com:17021
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=your_aiven_kafka_password
# Optional: paste full PEM cert as a single line with \n between lines
# KAFKA_CA_CERT=-----BEGIN CERTIFICATE-----\nMIIE...\n-----END CERTIFICATE-----

