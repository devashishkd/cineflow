PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Single Postgres DB for all tables (users, movies, theatres, shows, seats, bookings, payments)
# Use a Neon DB, Supabase, or any Postgres instance.
DB_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production

# ─── Redis ────────────────────────────────────────────────────────────────────
# Used for: rate limiting, movie/show cache, seat locks
REDIS_URL=redis://localhost:6379

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# ─── Email (Nodemailer / Gmail) ────────────────────────────────────────────────
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# ─── Kafka (Optional — used only for analytics-events topic) ──────────────────
# Leave empty to disable analytics Kafka publishing (degrades gracefully).
KAFKA_BROKER=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_CA_CERT=
