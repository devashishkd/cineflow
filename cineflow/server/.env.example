PORT=3000

# ─── Database (PostgreSQL via Docker) ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cineflow

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production

# ─── Redis via Docker ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# ─── Email (Nodemailer / Gmail) ────────────────────────────────────────────────
SMTP_USER=
SMTP_PASS=

# ─── Kafka (Optional) ─────────────────────────────────────────────────────────
KAFKA_BROKER=localhost:9092
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_CA_CERT=
