PORT=3000

# ─── Database (MongoDB) ───────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cineflow?appName=Cluster0

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_super_secret_jwt_key

# ─── Redis (Optional / Cloud Redis e.g. Upstash) ──────────────────────────────
REDIS_URL=redis://localhost:6380

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# ─── Email (Nodemailer / Gmail) ────────────────────────────────────────────────
SMTP_USER=
SMTP_PASS=
